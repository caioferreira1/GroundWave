# Supabase (your own project, not Lovable Cloud)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Gateway — see Passo 0 in the plan.
# "direct"  -> calls ai.gateway.lovable.dev straight from this app using LOVABLE_API_KEY
# "proxy"   -> calls a thin Edge Function (AI_PROXY_URL) that itself calls the gateway
#              from inside a Lovable Cloud project, using AI_PROXY_SECRET as a shared secret
AI_GATEWAY_MODE=direct
LOVABLE_API_KEY=
AI_PROXY_URL=
AI_PROXY_SECRET=

# Reddit ingestion — comma-separated list, tried in order; searchReddit()
# falls back to the next key on a 429 / monthly-quota-exceeded response.
# reddit34's BASIC plan is capped at 50 requests/month per key, which is
# easy to exhaust — keep a spare key in the list.
RAPIDAPI_KEYS=
RAPIDAPI_HOST=reddit34.p.rapidapi.com

# Cron protection (Vercel sets this automatically as a bearer token when
# CRON_SECRET is configured on the project — see api/cron/reddit-ingest)
CRON_SECRET=
